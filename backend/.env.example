# Development template. For production, see .env.production.example.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nirbhayaraksha
# Use a long random secret (at least 32 characters). Never commit the real .env.
JWT_SECRET=replace-with-a-long-random-secret
# Accepted formats: 60s, 30m, 12h, 1d
JWT_EXPIRES_IN=1d
# Comma-separated exact origins. No wildcards, paths, or trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Express trust proxy setting. Keep "false" for direct connections. Behind a
# single reverse proxy, use 1. Or list trusted IPs/subnets, such as
# "10.0.0.0/8,loopback". Do not use "true" (it trusts spoofable headers).
TRUST_PROXY=false
# One of: error, warn, info, debug. Health-check successes log at debug.
LOG_LEVEL=info
