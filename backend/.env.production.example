# Copy this file to .env.production, or set these values in your hosting
# provider's secret manager. Never commit a real .env.production file.
#
# The placeholder JWT_SECRET below is intentionally rejected in production
# by config/env.js. Replace it before starting the server.

NODE_ENV=production
PORT=5000

# MongoDB connection string. Treat this as a secret because it may contain
# database credentials. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a 64-byte random hex secret (128 characters), for example:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never reuse a development secret in production.
JWT_SECRET=replace-with-a-long-random-secret

# Accepted formats: 60s, 30m, 12h, 1d
JWT_EXPIRES_IN=1d

# Comma-separated exact HTTPS origins. No wildcards, paths, or trailing slashes.
# Include every production frontend origin that must call the API.
CORS_ORIGINS=https://app.example.com

# Express trust proxy setting. Set this to the number of trusted proxy hops
# (usually 1 for a single load balancer or reverse proxy), or to a
# comma-separated list of trusted IPs/subnets such as "10.0.0.0/8,loopback".
# Keep "false" when clients connect directly. Do not use "true".
TRUST_PROXY=1

# One of: error, warn, info, debug. Use info in production unless you are
# actively debugging. Health-check successes log at debug.
LOG_LEVEL=info
